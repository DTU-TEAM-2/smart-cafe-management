# Supply these in the environment. Spring does not automatically load .env files.
DB_URL=jdbc:mysql://127.0.0.1:3306/smart_cafe_menu?serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=
# Optional until shared identity provider exists. Without both, all tokens are rejected.
MENU_JWT_ISSUER=
MENU_JWT_AUDIENCE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Separate schema for tests. Never point tests at the application or legacy database.
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/smart_cafe_menu_test?serverTimezone=UTC
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
