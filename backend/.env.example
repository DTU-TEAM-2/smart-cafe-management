# Smart Cafe Backend Configuration Template
SERVER_PORT=8080
# Optional dev/prod; no profile is selected by default.
SPRING_PROFILES_ACTIVE=

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://127.0.0.1:3306/smart_cafe?connectionTimeZone=UTC
DB_USERNAME=cafe_app
DB_PASSWORD=

# Security Secrets (Must be at least 32 characters for HMAC-SHA256)
# Use the same signing secret as the authentication module. Never commit its real value.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_VALIDITY_SECONDS=86400
OTP_VALIDITY_SECONDS=600
PENDING_REGISTRATION_VALIDITY_SECONDS=86400

# Mail SMTP Configuration (Gmail or MailHog / Mock SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Supply credentials for an authorized test mailbox privately.
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
# For Gmail, set this explicitly to SMTP_USERNAME or a provider-authorized alias.
# An explicitly blank value uses the legacy no-reply fallback, not SMTP_USERNAME.
SMTP_FROM=

# Live Firebase Storage is disabled by the free-only policy. Do not enable billing/Blaze.
# Use backend/firebase-emulator/env.example for free local images; no cloud bucket/key is required.
NEWS_FIREBASE_BUCKET=
# Path outside the repository; never copy the service-account JSON into source control.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional isolated local tests only: SPRING_PROFILES_ACTIVE=firebase-emulator and a MySQL *_test DB.
# This mode uses no cloud account/key and refuses non-loopback endpoints or system databases.
NEWS_FIREBASE_EMULATOR_HOST=

# Cloudinary Configuration for Menu media assets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Tests use the approved schema in an isolated *_test database only.
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/smart_cafe_ci_test?connectionTimeZone=UTC
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=
