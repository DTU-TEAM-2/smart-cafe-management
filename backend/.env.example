# Smart Cafe Backend Configuration Template
# Server Port
PORT=8080

# Database Configuration (MySQL 8.0)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_cafe?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Security Secrets (Must be at least 32 characters for HMAC-SHA256)
AUTH_TOKEN_SECRET=replace_with_a_secure_random_hex_or_base64_string_min_32_chars
AUTH_TOKEN_EXPIRATION_SECONDS=86400
AUTH_OTP_HMAC_SECRET=replace_with_a_secure_hmac_secret_for_otp_hashing_min_32_chars

# Mail SMTP Configuration (Gmail or MailHog / Mock SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_google_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=no-reply@smartcafe.vn
