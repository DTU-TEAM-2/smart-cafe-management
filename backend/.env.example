DB_URL=jdbc:mysql://127.0.0.1:3306/smart_cafe?connectionTimeZone=UTC
DB_USERNAME=smart_cafe_app
DB_PASSWORD=
SERVER_PORT=8080
# Use the same signing secret as the authentication module. Never commit its real value.
AUTH_TOKEN_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Tests use the approved schema in an isolated *_test database only.
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/smart_cafe_ci_test?connectionTimeZone=UTC
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=
# Feedback Firebase: disabled until the responsible member supplies a bucket and credentials.
FEEDBACK_FIREBASE_ENABLED=false
FIREBASE_STORAGE_BUCKET=
# Path outside Git; never paste the service-account JSON here.
GOOGLE_APPLICATION_CREDENTIALS=
FEEDBACK_PER_SOURCE_PER_MINUTE=20
FEEDBACK_TOTAL_PER_MINUTE=120
FEEDBACK_CONCURRENT_MULTIPART=2
FEEDBACK_CSRF_PER_SOURCE_PER_MINUTE=12
FEEDBACK_CSRF_TOTAL_PER_MINUTE=60
