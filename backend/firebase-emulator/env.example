# Copy to backend/.env.emulator (ignored by Git), then edit for your own MySQL and auth module.
DB_URL=jdbc:mysql://127.0.0.1:3306/smart_cafe_local_test?connectionTimeZone=UTC
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
AUTH_TOKEN_SECRET=
SPRING_PROFILES_ACTIVE=firebase-emulator
NEWS_FIREBASE_EMULATOR_HOST=http://127.0.0.1:19199
# No Firebase account, cloud bucket, billing or service-account key is needed in this mode.
NEWS_FIREBASE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
