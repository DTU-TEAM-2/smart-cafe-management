    {
      "name": "19. Luồng hoàn chỉnh - Xác minh OTP thành công (Nhận resetToken)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.unset(\"resetToken\");",
              "pm.test(\"OTP verification must succeed and return a reset grant\", function () {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json();",
              "    pm.expect(data.purpose).to.eql(\"RESET\");",
              "    pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
              "    pm.environment.set(\"resetToken\", data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
