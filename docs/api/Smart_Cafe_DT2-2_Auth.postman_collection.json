    {
      "name": "13. Quên mật khẩu - Email hợp lệ (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Returns neutral message and challengeId\", function () {",
              "    pm.expect(jsonData.message).to.be.a('string');",
              "    pm.expect(jsonData.challengeId).to.be.a('string');",
              "    pm.expect(jsonData.expiresInSeconds).to.eql(600);",
              "});",
              "if (jsonData.challengeId) {",
              "    pm.environment.set(\"challengeId\", jsonData.challengeId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
