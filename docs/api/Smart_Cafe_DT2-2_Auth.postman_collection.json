{
  "info": {
    "_postman_id": "smart-cafe-dt2-2-auth-collection",
    "name": "Smart Cafe - DT2-2 Authentication & Password Recovery",
    "description": "Bộ kiểm thử API tự động cho task DT2-2 (Đăng nhập, Phân quyền RBAC, Quên mật khẩu qua Email, OTP 6 số, Đặt lại mật khẩu).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth - Đăng nhập Admin thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Returns valid accessToken and tokenType\", function () {",
              "    pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
              "    pm.expect(jsonData.user).to.be.an('object');",
              "    pm.expect(jsonData.user.role).to.eql('ADMIN');",
              "    pm.expect(jsonData.user.username).to.eql(pm.environment.get(\"adminUsername\"));",
              "});",
              "if (jsonData.token) {",
              "    pm.environment.set(\"adminToken\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
