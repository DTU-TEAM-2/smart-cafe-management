          }
        ],
        "url": "{{baseUrl}}/api/v1/customer/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\"tableId\":95001}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
