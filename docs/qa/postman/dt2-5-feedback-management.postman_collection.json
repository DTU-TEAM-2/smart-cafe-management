{
  "info": { "name": "DT2-5 Admin Feedback — isolated read API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Run against an isolated *_test schema with synthetic fixtures. Supply tokens at runtime. No Firebase or production data." },
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:18085" }, { "key": "adminToken", "value": "" }, { "key": "staffToken", "value": "" }],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
  "item": [
    { "name": "List ADMIN — five fields and pagination", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/feedbacks?size=1" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200, no-store and fields', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); const b=pm.response.json(); pm.expect(b.content).to.have.lengthOf(1); ['id','creator','email','date','content'].forEach(k=>pm.expect(b.content[0]).to.have.property(k)); pm.expect(b.content[0].id).to.be.a('string'); });"] } }] },
    { "name": "Detail fixture", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/feedbacks/96001" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('detail and empty images', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.id).to.eql('96001'); pm.expect(b.creator).to.eql('Khách kiểm thử HTTP'); pm.expect(b.rating).to.eql(5); pm.expect(b.images).to.eql([]); });"] } }] },
    { "name": "Cafe date with result", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/feedbacks?date=2026-11-19" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('cafe date result', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.totalElements).to.eql(1); pm.expect(b.content[0].id).to.eql('96001'); pm.expect(b.content[0].date).to.eql('2026-11-19'); });"] } }] },
    { "name": "No results", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/feedbacks?date=2026-11-21" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('empty is 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().content).to.eql([]); });"] } }] },
    { "name": "Page 1 oldest", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/feedbacks?page=1&size=1&sort=oldest" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('stable second page', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().content[0].id).to.eql('96002'); });"] } }] },
    { "name": "Missing ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/feedbacks/9223372036854775807" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 Problem Details', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().code).to.eql('FEEDBACK_NOT_FOUND'); });"] } }] },
    { "name": "Invalid date", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/feedbacks?date=2026-02-30" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] } }] },
    { "name": "No bearer", "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/api/v1/admin/feedbacks" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }] },
    { "name": "STAFF denied", "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staffToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/admin/feedbacks" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }] }
  ]
}
