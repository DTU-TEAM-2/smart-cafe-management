          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Problem Details tiếng Việt\", () => {const r=pm.response.json(); pm.expect(r.status).to.eql(400); pm.expect(r.title).to.eql(\"Thông tin phản hồi không hợp lệ\");});"
            ]
          }
        }
      ]
    },
