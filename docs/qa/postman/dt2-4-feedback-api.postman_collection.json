{
  "info": {
    "name": "DT2-4 — Feedback văn bản",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chỉ chạy trên backend/DB test biệt lập. Không kiểm chứng Firebase hoặc quyền phiên."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18084"
    }
  ],
  "item": [
    {
      "name": "Lấy CSRF cho phản hồi",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/customer/feedback/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const c=pm.response.json(); pm.collectionVariables.set(\"feedbackCsrf\",c.token); pm.test(\"CSRF không cache\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Gửi phản hồi hợp lệ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{feedbackCsrf}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customer/feedback",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Khách kiểm thử\",\"email\":\"customer@example.invalid\",\"content\":\"Đồ uống ngon!\",\"rating\":5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Lời cảm ơn và ID, không lộ email\",()=>{const r=pm.response.json(); pm.expect(r.message).to.eql(\"Cảm ơn bạn đã gửi phản hồi!\"); pm.expect(r.id).to.match(/^\\d+$/); pm.expect(r).not.to.have.property(\"email\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Thiếu các trường bắt buộc",
      "request": {
        "method": "POST",
        "header": [
