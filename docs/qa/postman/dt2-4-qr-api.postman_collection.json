{
  "info": {
    "name": "DT2-4 — QR, nhận diện bàn (chưa cấp phiên)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18084"
    }
  ],
  "item": [
    {
      "name": "1. QR bàn A không cần đăng nhập",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/customer/tables/qr/7d57e0b0-dfca-4ed3-846a-5b77e4450001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Đúng bàn, không cấp quyền phiên', () => { const b=pm.response.json(); pm.expect(b.tableId).to.eql('81001'); pm.expect(b).to.have.all.keys('tableId','tableCode','tableName'); });"
            ]
          }
        }
      ]
    },
