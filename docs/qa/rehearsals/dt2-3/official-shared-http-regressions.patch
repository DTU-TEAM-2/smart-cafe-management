+    private HttpResponse<String> management(String method, String path, String bearer, Object body) throws Exception {
+        var csrf = call("GET", "/staff/csrf", login(1), null);
+        assertThat(csrf.statusCode()).isEqualTo(200);
+        String cookie = csrf.headers().allValues("Set-Cookie").stream().map(v -> v.split(";", 2)[0])
+                .collect(java.util.stream.Collectors.joining("; "));
+        var request = HttpRequest.newBuilder(URI.create("http://127.0.0.1:" + port + "/api/v1" + path))
+                .timeout(Duration.ofSeconds(20)).header("Content-Type", "application/json")
+                .header("Authorization", "Bearer " + bearer).header("Cookie", cookie)
+                .header((String) value(csrf, "$.headerName"), (String) value(csrf, "$.token"));
+        return client.send(request.method(method, body == null ? HttpRequest.BodyPublishers.noBody()
+                : HttpRequest.BodyPublishers.ofString(JSON.writeValueAsString(body))).build(), HttpResponse.BodyHandlers.ofString());
+    }
