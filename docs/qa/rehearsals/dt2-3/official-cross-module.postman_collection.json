{
  "info": {
    "name": "DT2-3 candidate cross-module HTTP regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Candidate-only, real Login/Tomcat/verified MySQL. Seven Staff requests/payloads preserved from official57ea6f1 with additional status assertions. No News/Bills collection exists at pinned refs; these HTTP checks supplement unchanged native business/realtime suites."
  },
  "item": [
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"pm_profile_admin2\", \"password\": \"{{fixturePassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('real signed bearer',()=>pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.environment.set('integrationAdminBearer',pm.response.json().token);"
            ]
          }
        }
      ]
    },
